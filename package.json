{
  "name": "iron-golem-ts",
  "version": "0.2.0",
  "description": "TypeScript strict mode enforcer and historical analyzer via git.",
  "main": "dist/index.js",
  "bin": {
    "iron-golem-ts": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "tsc": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "node --require ts-node/register --test test/*/*.test.ts",
    "check": "npm run tsc && npm run lint && npm run test",
    "example": "npm run build && node --require ts-node/register example/seed.ts",
    "prePublish": "npm run build"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "decoders": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^6.19.1",
    "@typescript-eslint/parser": "^6.19.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.3.2",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "typescript",
    "strict",
    "tsc",
    "git",
    "chart",
    "tooling"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/programever/iron-golem-ts.git"
  },
  "bugs": {
    "url": "https://github.com/programever/iron-golem-ts/issues"
  },
  "homepage": "https://github.com/programever/iron-golem-ts",
  "author": "Programever",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
